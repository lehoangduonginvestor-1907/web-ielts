# Sao file này thành .env.local (chạy trên máy) hoặc khai báo trong Vercel → Settings → Environment Variables.
# Không đặt LEARNER_CODE thì app không khoá gì (dùng trên máy riêng).

# Mã vào cửa của người học và của người kèm (tự đặt, nên dài từ 10 ký tự)
LEARNER_CODE=
COACH_CODE=
# Chuỗi ngẫu nhiên dài để ký cookie phiên (đổi chuỗi này là mọi máy phải nhập mã lại)
AUTH_SECRET=

# Kho Vercel Blob RIÊNG TƯ chứa đề và tiến độ. Vercel tự thêm biến này khi nối kho với project.
# Có biến này thì app đọc/ghi trên Blob thay vì thư mục content/ và data/.
BLOB_READ_WRITE_TOKEN=

# Khoá API Google Gemini (tùy chọn đặt ở đây hoặc nhập trong Nhật ký → Cài đặt khi chạy trên máy).
# Đây là bộ chấm mặc định cho cả hai kỹ năng:
#   - Speaking: Gemini 3.8 Live Extended Thinking làm giám khảo nói chuyện trực tiếp; chấm bằng
#     Gemini 4 Hydrogen → dự phòng Gemini 3.8 Flash (suy luận high), nghe toàn bộ file ghi âm
#   - Writing: Gemini 4 Hydrogen → Gemini 3.8 Flash → (cả hai lỗi) các model ngoài Gemini bên dưới
# Writing và Speaking dùng chung hạn mức Hydrogen (gói miễn phí ~20 lượt/ngày); hết lượt thì tự chuyển 3.8 Flash.
GEMINI_API_KEY=
#
# Đổi model khi Google đổi tên / ngừng model (không cần sửa code). Danh sách cách nhau bằng dấu phẩy, thử lần lượt.
# WRITING_GEMINI_MODELS=gemini-4-hydrogen,gemini-3.8-flash
# SPEAKING_GRADE_MODELS=gemini-4-hydrogen,gemini-3.8-flash
# GEMINI_LIVE_MODEL=gemini-3.8-live-extended-thinking     # giám khảo Speaking, chế độ "Extended Thinking"
# GEMINI_LIVE_FAST_MODEL=gemini-3.8-live                  # giám khảo Speaking, chế độ "Faster & lighter"

# ---- Dự phòng cho Writing bằng model ngoài Gemini (miễn phí), chỉ dùng khi Gemini lỗi ----
# Có key nào thì dùng key đó, thử theo thứ tự WRITING_PROVIDERS (mặc định nvidia,groq,openrouter).
# WRITING_PROVIDERS=nvidia,groq,openrouter
#
# NVIDIA (ưu tiên): https://build.nvidia.com — tài khoản NVIDIA Developer, xác minh số điện thoại, không cần thẻ.
# Miễn phí ~40 lượt/phút, không giới hạn token/phút. NVIDIA GHI LẠI nội dung gửi lên để cải thiện sản phẩm.
# Chỉ dùng model gắn nhãn "Free Endpoint". Mặc định Nemotron 3 Ultra: khi thử (18/11/2026) chấm khớp Gemini 4 Hydrogen,
# ~95 giây/bài. GLM 5.3 Flash / Kimi K3.1 Pro / Mistral Large 4 lúc đó quá chậm (>150 giây), DeepSeek V4.1 Flash đã ngừng.
NVIDIA_API_KEY=
# NVIDIA_WRITING_MODEL=nvidia/nemotron-3-ultra-550b-a55b
#
# Groq: https://console.groq.com/keys — đăng ký miễn phí, không cần thẻ.
# Gói miễn phí ~1.000 lượt/ngày nhưng chỉ ~8.000 token/phút → chấm từng bài một.
GROQ_API_KEY=
# GROQ_WRITING_MODEL=openai/gpt-oss-120b
# GROQ_TPM_LIMIT=8000
#
# OpenRouter (dự phòng): https://openrouter.ai/settings/keys — model đuôi ":free" miễn phí,
# ~50 lượt/ngày cho cả tài khoản (≈1.000 lượt/ngày nếu từng nạp 10 USD).
OPENROUTER_API_KEY=
# OPENROUTER_WRITING_MODEL=nvidia/nemotron-3.5-super-vl:free

# ---- Nhắc học tự động ngoài trình duyệt (tùy chọn, gọi GET /api/reminder bằng Cron lúc 20:00) ----
# REMINDER_SECRET=          # hoặc dùng CRON_SECRET mặc định của Vercel Cron (Authorization: Bearer <secret>)
# REMINDER_TZ_OFFSET=7      # múi giờ của người học (mặc định +7 cho Việt Nam)
# APP_URL=                  # link web đính kèm trong tin nhắn nhắc học
# TELEGRAM_BOT_TOKEN=       # tạo qua @BotFather nếu muốn nhận nhắc học qua Telegram
# TELEGRAM_CHAT_ID=
# REMINDER_WEBHOOK_URL=     # hoặc webhook Discord / Slack / ntfy bất kỳ
