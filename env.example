# Sao file này thành .env.local (chạy trên máy) hoặc khai báo trong Vercel → Settings → Environment Variables.
# Không đặt LEARNER_CODE thì app không khoá gì (dùng trên máy riêng).

# Mã vào cửa của người học và của người kèm (tự đặt, nên dài từ 10 ký tự)
LEARNER_CODE=
COACH_CODE=
# Chuỗi ngẫu nhiên dài để ký cookie phiên (đổi chuỗi này là mọi máy phải nhập mã lại)
AUTH_SECRET=

# Kho Vercel Blob RIÊNG TƯ chứa đề và tiến độ. Vercel tự thêm biến này khi nối kho với project.
# Có biến này thì app đọc/ghi trên Blob thay vì thư mục content/ và data/.
BLOB_READ_WRITE_TOKEN=

# Khoá API Google Gemini — CHỈ dùng cho giám khảo Speaking nói chuyện trực tiếp (Gemini Live).
# Tùy chọn đặt ở đây hoặc nhập trong Nhật ký → Cài đặt khi chạy trên máy.
# Chấm Writing / Speaking KHÔNG dùng API: người học chấm bằng Gemini của mình trong thanh Gemini của Chrome
# (hoặc gemini.google.com), rồi dán kết quả JSON vào trang bài làm; máy chủ chỉ kiểm tra và tính band.
GEMINI_API_KEY=
#
# Đổi model giám khảo khi Google đổi tên / ngừng model (không cần sửa code):
# GEMINI_LIVE_MODEL=gemini-3.8-live-extended-thinking     # chế độ "Extended Thinking"
# GEMINI_LIVE_FAST_MODEL=gemini-3.8-live                  # chế độ "Faster & lighter"

# ---- Nhắc học tự động ngoài trình duyệt (tùy chọn, gọi GET /api/reminder bằng Cron lúc 20:00) ----
# REMINDER_SECRET=          # hoặc dùng CRON_SECRET mặc định của Vercel Cron (Authorization: Bearer <secret>)
# REMINDER_TZ_OFFSET=7      # múi giờ của người học (mặc định +7 cho Việt Nam)
# APP_URL=                  # link web đính kèm trong tin nhắn nhắc học
# TELEGRAM_BOT_TOKEN=       # tạo qua @BotFather nếu muốn nhận nhắc học qua Telegram
# TELEGRAM_CHAT_ID=
# REMINDER_WEBHOOK_URL=     # hoặc webhook Discord / Slack / ntfy bất kỳ
